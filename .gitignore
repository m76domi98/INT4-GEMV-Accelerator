# Simulator build output (cocotb, Icarus, Verilator)
sim_build/
results.xml
*.vcd
*.fst
obj_dir/
__pycache__/
*.pyc

# Local virtual environments
.venv/
venv/

# Exported weights and activations are rebuilt by make export.
# Keep the small manifest (model revision, scales, versions) as the record.
export/out/*
!export/out/manifest.json

# Generated results are rebuilt by make results; keep only the .gitkeep
# and the Stage 1 golden log, which the spec cites.
results/*
!results/.gitkeep
!results/stage1_golden.log
